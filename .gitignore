# Environment / secrets
.env
.env.*
!.env.example

# Virtual environments
.venv/
venv/

# Python bytecode and caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Coverage
.coverage
.coverage.*
htmlcov/

# Build artifacts
dist/
build/
*.egg-info/

# Local document storage (must never contain real corporate data)
storage/documents/*
storage/staging/*
!storage/documents/.gitkeep
!storage/staging/.gitkeep

# Editors
.idea/
.vscode/

# OS noise
.DS_Store
Thumbs.db

# Logs
*.log
