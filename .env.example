# Application
APP_NAME=security-ai-backend
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true

# API
API_V1_PREFIX=/api/v1

# PostgreSQL (valores ficticios SOLO para desarrollo local)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=security_ai
POSTGRES_USER=security_ai
POSTGRES_PASSWORD=security_ai_dev_password

# Redis / Celery broker (valores ficticios SOLO para desarrollo local).
# Dentro de Docker Compose, REDIS_HOST se sobrescribe a "redis" en compose.yaml.
# No existe CELERY_BROKER_URL: el broker se deriva de estas tres variables.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0